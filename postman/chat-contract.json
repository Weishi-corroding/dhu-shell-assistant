{
  "openapi": "3.0.3",
  "info": {
    "title": "Lab Shell Chat Completions contract subset",
    "version": "1.0.0",
    "description": "Locally authored subset of https://api-docs.deepseek.com/api/create-chat-completion/ ; deterministic test content, not a real model."
  },
  "paths": {
    "/chat/completions": {
      "post": {
        "operationId": "createChatCompletion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "messages"],
                "properties": {
                  "model": {"type": "string"},
                  "stream": {"type": "boolean"},
                  "messages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["role", "content"], "properties": {"role": {"type": "string", "enum": ["system", "user", "assistant"]}, "content": {"type": "string"}}}}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A deterministic chat completion fixture",
            "content": {"application/json": {"schema": {"type": "object", "required": ["choices"], "properties": {"choices": {"type": "array", "items": {"type": "object"}}}}, "example": {"id": "chatcmpl-lab-fixture", "object": "chat.completion", "created": 0, "model": "fixture-model", "choices": [{"index": 0, "message": {"role": "assistant", "content": "{\"command\":\"df -h\",\"explanation\":\"显示磁盘空间（本地接口测试数据）。\"}"}, "finish_reason": "stop"}]}}}
          },
          "401": {"description": "Invalid credentials", "content": {"application/json": {"example": {"error": {"message": "Invalid API key", "type": "authentication_error"}}}}},
          "429": {"description": "Rate limited", "content": {"application/json": {"example": {"error": {"message": "Rate limit reached", "type": "rate_limit_error"}}}}},
          "500": {"description": "Upstream unavailable", "content": {"application/json": {"example": {"error": {"message": "Unavailable", "type": "server_error"}}}}}
        }
      }
    }
  }
}
