# Copy this file to .env and edit it. The application reads .env automatically.
# Existing process environment variables take priority; no shell sourcing is needed.
# BASEURL, API_KEY and MODEL are also supported aliases.
SHELL_AI_API_KEY=replace_with_your_key
SHELL_AI_BASE_URL=https://api.deepseek.com
SHELL_AI_MODEL=deepseek-flash
SHELL_AI_TIMEOUT=30
